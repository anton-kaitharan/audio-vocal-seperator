# Telegram Bot Configuration
BOT_TOKEN_ENV=your_bot_token_here
ALLOWED_ID_ENV=123456789
CHAT_ID_ENV=123456789

# Backend Server Port (auto-assigned by cloud platforms like Railway, Render, Fly.io)
PORT=5000

# Modal Serverless GPU Webhook URL (from `modal deploy app.py`)
MODAL_API_URL=https://<your-workspace>--auravocal-backend-separate-track.modal.run

# Frontend API URL (set in frontend/.env.local or Vercel dashboard)
# NEXT_PUBLIC_API_URL=http://localhost:5000

# Cloudflare R2 Credentials (set in Modal Secret: `modal secret create r2-credentials ...`)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=your_r2_bucket_name
# R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com


